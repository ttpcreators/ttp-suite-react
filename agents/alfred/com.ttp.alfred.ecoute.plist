<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Alfred : écoute Telegram en continu, pour répondre à Marc tout de suite. Démarre avec la
     session et redémarre si elle s'arrête. Installé par installer.sh (HOME remplacé). -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.ttp.alfred.ecoute</string>
  <key>ProgramArguments</key><array>
    <string>/bin/zsh</string>
    <string>__HOME__/Code/TTPAlfred/ecoute.sh</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
</dict></plist>
